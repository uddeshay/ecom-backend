{
  "name": "ecom-be",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@model/(.*)$": "<rootDir>/models/$1",
      "^@service/(.*)$": "<rootDir>/services/$1",
      "^@validator/(.*)$": "<rootDir>/validators/$1"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "~4.16.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "moment": "^2.30.1",
    "mongoos": "^0.0.1-security",
    "mongoose": "^9.4.1",
    "morgan": "~1.9.1",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "_moduleAliases": {
    "@validator": "./validators",
    "@service": "./services",
    "@model": "./models"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
